{
  "name": "unminify-js",
  "version": "1.0.0",
  "type": "module",
  "description": "Offline web unminifier for JavaScript, JSON, CSS and HTML",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EwenLoy/unminify-js.git"
  },
  "homepage": "https://ewenloy.github.io/unminify-js/",
  "keywords": [
    "unminify",
    "beautify",
    "pretty-print",
    "formatter",
    "javascript",
    "json",
    "css",
    "html",
    "offline"
  ],
  "scripts": {
    "dev": "npm run build:standalone && vite",
    "build": "tsc --noEmit && npm run build:standalone && vite build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acorn": "8.16.0",
    "codemirror": "5.65.21"
  },
  "devDependencies": {
    "@types/codemirror": "^5.60.15",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "chai": "^5.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
